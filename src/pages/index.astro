---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
const b = import.meta.env.BASE_URL;
const p = (slug: string) => `${b}work/${slug}/`;
const media = (name: string) => `${b}media/${name}.webp`;
const campaign = projects[0], teaching = projects[1], nagar = projects[2], map = projects[3];
---
<Base title="Fahad MD Akramul Islam — Community, ICT & Planning" description="Selected work by Fahad MD Akramul Islam, Community Expert and ICT Instructor at Chorcha and Urban & Regional Planning student at RUET.">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Fahad MD Akramul Islam / Portfolio 2026</p>
      <h1>Fahad MD<br /><em>Akramul</em> Islam<span class="hero-period">.</span></h1>
      <div class="hero-bottom"><p>I build student communities, teach ICT, and explore how better planning can serve people. I’m a <strong>Community Expert</strong> and <strong>ICT Instructor</strong> at Chorcha, and an Urban &amp; Regional Planning student at RUET, Series 24.</p><div class="hero-actions"><a class="button" href="#selected">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href="https://www.linkedin.com/in/fahad-md-akramul-islam/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
    </div>
    <figure class="hero-media"><img src={media('studio')} srcset={`${b}media/studio-480.webp 480w, ${b}media/studio.webp 676w`} sizes="(max-width: 800px) 100vw, 40vw" width="676" height="507" alt="Fahad in the Chorcha recording studio beside an ICT lesson screen" fetchpriority="high" /><figcaption><span>01 / At work</span><span>Chorcha recording studio</span></figcaption></figure>
  </section>
  <section class="metrics shell" aria-label="Work in numbers"><div><strong>35K <span>→</span> 160K</strong><p>Chorcha community members during my tenure<br />May 2025 – Nov 2026</p></div><div><strong>34K</strong><p>ICT video views<br />As of 15 Nov 2026</p></div><div><strong>1,121 h</strong><p>ICT video watch time<br />As of 15 Nov 2026</p></div></section>
  <section class="section shell" id="selected"><div class="section-heading"><div><p class="eyebrow">01 / Selected work</p><h2>Work in <em>context.</em></h2></div><p class="aside">A few projects across community, classrooms, and the places we share.</p></div>
    <article class="campaign-feature"><a class="project-image-link" href={p(campaign.slug)}><img class="project-image" src={media('studio')} srcset={`${b}media/studio-480.webp 480w, ${b}media/studio.webp 676w`} sizes="(max-width: 800px) 100vw, 55vw" width="676" height="507" alt={campaign.heroAlt} loading="lazy" /></a><div class="campaign-copy"><p class="eyebrow">Chorcha / Community</p><span class="giant-index">01</span><h3>{campaign.title}</h3><p>{campaign.short} Including 11.11 and the iPad Giveaway.</p><a class="text-link" href={p(campaign.slug)}>Read the case study ↗</a></div></article>
    <div class="feature-pair"><article class="teaching-feature"><div class="teaching-visual"><img src={media('ict-web')} srcset={`${b}media/ict-web-480.webp 480w, ${b}media/ict-web.webp 921w`} sizes="(max-width: 800px) 100vw, 45vw" width="921" height="576" alt="Bangla Chorcha app listing for Web Design and HTML" loading="lazy" /><img src={media('ict-number')} width="921" height="610" alt="Bangla Chorcha app listing for Number Systems" loading="lazy" /></div><div class="project-meta"><span>Chorcha / Teaching</span><span>02</span></div><h3 class="project-title"><a href={p(teaching.slug)}>{teaching.title} ↗</a></h3><p class="project-description">SSC 27 and HSC ICT, from course planning to live teaching.</p></article><article class="nagar-feature"><div class="nagar-visual" aria-hidden="true"><span class="nagar-label">NagarBondhu AI</span><div class="nagar-steps"><span>Report</span><i>→</i><span>Map</span><i>→</i><span>Track</span></div><span class="nagar-foot">রাজশাহীর জন্য নাগরিক সেবা</span></div><div class="project-meta"><span>Civic technology / Prototype</span><span>03</span></div><h3 class="project-title"><a href={p(nagar.slug)}>{nagar.title} ↗</a></h3><p class="project-description">A Bengali-language way to report neighborhood issues and follow their status.</p></article></div>
    <article class="map-feature"><div><div class="project-meta"><span>Planning / GIS</span><span>04</span></div><h3 class="project-title"><a href={p(map.slug)}>{map.title} ↗</a></h3><p class="project-description">Following recurring November water on cropland from Bangladesh to Naogaon and Manda.</p><a class="text-link" href={p(map.slug)}>Explore the map ↗</a></div><a class="project-image-link" href={p(map.slug)}><img src={media('map-crop')} width="1120" height="950" alt="Cropped map of Bangladesh districts shaded by recurring November water on cropland" loading="lazy" /></a></article>
    <div class="all-work"><a class="button ghost" href={`${b}work/`}>See all work <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="about-strip"><div class="shell"><p class="eyebrow">02 / About</p><div><h2>From communities<br />to <em>cities.</em></h2><p>I’m from Naogaon and study Urban &amp; Regional Planning at RUET. Education, civic technology and GIS keep pulling my work into new directions.</p><a class="text-link" href={`${b}about/`}>More about me ↗</a></div></div></section>
</Base>
<style>
.hero{display:grid;grid-template-columns:1.25fr .75fr;gap:42px;padding-top:82px;padding-bottom:78px;align-items:end}.hero-copy{min-width:0}.hero h1{font-size:clamp(5.5rem,9.3vw,10.2rem);letter-spacing:-.055em;margin:25px 0 45px;line-height:.82}.hero h1 em{color:var(--accent)}.hero-period{color:#9bb5a8}.hero-bottom{display:grid;grid-template-columns:1fr auto;gap:35px;align-items:end;border-top:1px solid var(--line);padding-top:20px}.hero-bottom p{max-width:48ch;color:var(--muted);font-size:.95rem}.hero-bottom strong{color:var(--ink);font-weight:600}.hero-actions{display:flex;flex-direction:column;align-items:start;gap:22px;white-space:nowrap}.hero-media img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:44% center}.hero-media figcaption{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;margin-top:10px}.metrics{display:grid;grid-template-columns:1.4fr 1fr 1fr;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}.metrics>div{padding:24px 30px 24px 0}.metrics>div+div{border-left:1px solid var(--line);padding-left:30px}.metrics strong{display:block;color:var(--ink);font:clamp(2.7rem,4.7vw,5rem)/1 var(--serif);white-space:nowrap}.metrics strong span{color:var(--accent)}.metrics p{color:var(--muted);font-size:.78rem;line-height:1.4;margin-top:9px}.campaign-feature{display:grid;grid-template-columns:1.15fr .85fr;background:#e3e9e2}.campaign-feature img{height:100%;min-height:440px;object-fit:cover;object-position:48%}.campaign-copy{padding:38px;display:flex;flex-direction:column;align-items:start}.giant-index{font:clamp(8rem,16vw,17rem)/.75 var(--serif);color:#adc4b6;align-self:end;margin-top:auto}.campaign-copy h3{font-size:clamp(3.3rem,5.5vw,6.3rem);max-width:8ch}.campaign-copy p:not(.eyebrow){margin:22px 0 30px;max-width:39ch;color:var(--muted)}.feature-pair{display:grid;grid-template-columns:1.08fr .92fr;gap:40px;margin-top:75px}.teaching-visual{background:#d5e0dc;min-height:380px;padding:28px;display:flex;align-items:center;gap:14px;overflow:hidden}.teaching-visual img{width:58%;box-shadow:0 18px 38px #183c3938}.teaching-visual img+img{width:58%;margin-right:-45%;transform:translateY(60px)}.nagar-visual{min-height:380px;background:#1c4c49;color:#e7f0e8;padding:30px;display:flex;flex-direction:column;justify-content:space-between}.nagar-label{font:3.4rem/1 var(--serif)}.nagar-steps{display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:clamp(1.25rem,2vw,2rem);font-weight:500}.nagar-steps span{border-bottom:1px solid #7daaa2;padding-bottom:8px}.nagar-steps i{font-style:normal;color:#9bbcb5}.nagar-foot{font-size:.78rem;letter-spacing:.08em}.map-feature{margin-top:85px;border-top:1px solid var(--line);padding-top:24px;display:grid;grid-template-columns:.7fr 1.3fr;gap:50px;align-items:center}.map-feature .project-meta{border-top:0;margin-top:0}.map-feature .project-title{font-size:clamp(3.3rem,5.8vw,6.8rem);margin-top:60px}.map-feature .text-link{margin-top:35px}.map-feature img{width:100%;height:450px;object-fit:cover;object-position:50% 36%;background:#fff}.all-work{text-align:center;margin-top:70px}.about-strip{background:#dfe9e2;padding:95px 0}.about-strip .shell>div{display:grid;grid-template-columns:1fr .55fr;gap:50px;align-items:end}.about-strip h2{font-size:clamp(4.2rem,8vw,9rem);margin-top:20px}.about-strip p:not(.eyebrow){color:var(--muted);max-width:40ch}.about-strip .text-link{grid-column:2;justify-self:start;margin-top:-20px}
@media(max-width:1000px){.hero{grid-template-columns:1fr .8fr}.hero h1{font-size:clamp(5rem,8vw,8rem)}.hero-bottom{grid-template-columns:1fr}.hero-actions{flex-direction:row;align-items:center}.giant-index{font-size:11rem}.feature-pair{gap:24px}}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:48px;padding-bottom:45px;gap:32px}.hero h1{font-size:clamp(4.5rem,13vw,8rem);margin:28px 0 35px}.hero-media img{aspect-ratio:1.35;object-position:center 43%}.metrics{grid-template-columns:repeat(3,1fr)}.metrics>div,.metrics>div+div{padding:14px 8px}.metrics strong{font-size:clamp(1.45rem,4vw,3rem)}.metrics p{font-size:.68rem}.campaign-feature,.feature-pair,.map-feature,.about-strip .shell>div{grid-template-columns:1fr}.campaign-feature img{min-height:0;aspect-ratio:1.3}.campaign-copy{min-height:370px}.feature-pair{margin-top:48px}.map-feature{margin-top:55px;gap:20px}.map-feature .project-title{margin-top:25px}.map-feature img{height:300px}.about-strip .text-link{grid-column:auto;margin-top:0}.about-strip{padding:60px 0}}
@media(max-width:470px){.hero h1{font-size:clamp(4.1rem,14.7vw,6rem)}.hero-actions{flex-wrap:wrap}.metrics{grid-template-columns:1fr 1fr}.metrics>div:first-child{grid-column:1/-1;border-bottom:1px solid var(--line)}.metrics>div:nth-child(2){border-left:0;padding-left:0}.metrics>div:nth-child(3){padding-left:18px}.metrics strong{font-size:2.4rem}.campaign-copy{padding:23px;min-height:340px}.giant-index{font-size:10rem}.teaching-visual,.nagar-visual{min-height:295px}.nagar-label{font-size:2.6rem}.nagar-steps{font-size:1.15rem}.about-strip h2{font-size:clamp(3.5rem,12vw,4.7rem)}}
@media(prefers-reduced-motion:no-preference){.hero-copy{animation:rise .7s both}.hero-media{animation:rise .7s .12s both}@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}}
</style>
