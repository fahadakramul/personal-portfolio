---
import Base from '../layouts/Base.astro';
const b = import.meta.env.BASE_URL;
---
<Base title="Page not found — Fahad MD Akramul Islam" description="This portfolio page could not be found. Return home or explore Fahad's work.">
  <section class="shell notfound"><p class="eyebrow">404 / Wrong turn</p><h1>Lost your <em>way?</em></h1><p>This page isn’t here. There’s more to see in the work index.</p><div><a class="button" href={b}>Back home ↗</a><a class="button ghost" href={`${b}work/`}>Browse work ↗</a></div></section>
</Base>
<style>.notfound{padding:130px 0 80px}.notfound h1{font-size:clamp(5rem,10vw,11rem);margin:20px 0}.notfound>p:last-of-type{color:var(--muted)}.notfound div{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}</style>
