---
import Base from '../layouts/Base.astro';
const b = import.meta.env.BASE_URL;
---
<Base title="About — Fahad MD Akramul Islam" description="About Fahad MD Akramul Islam: Community Expert and ICT Instructor at Chorcha, and Urban & Regional Planning student at RUET, Series 24.">
  <div class="shell page-intro"><p class="eyebrow">About / Fahad</p><h1>Curiosity is<br /><em>my compass.</em></h1><p>I’m from Naogaon, Bangladesh. I work with student communities and teach ICT while studying Urban &amp; Regional Planning at RUET, Series 24. GIS and civic technology connect the two sides of my work.</p></div>
  <section class="about-image shell"><img src={`${b}media/studio.webp`} srcset={`${b}media/studio-480.webp 480w, ${b}media/studio.webp 676w`} sizes="(max-width: 800px) 100vw, 50vw" width="676" height="507" alt="Fahad at the Chorcha recording studio" /><div><p class="eyebrow">In practice</p><h2>People,<br /><em>places,</em><br />possibilities.</h2><p>At Chorcha, I listen to learners, help them find their way through the platform, communicate campaigns, and teach SSC and HSC ICT. At RUET, I learn to read places through surveys, maps and design.</p></div></section>
  <section class="shell about-columns"><div><p class="eyebrow">01 / Experience</p><h2>Where I’ve <em>worked.</em></h2><ul><li><strong>Chorcha</strong><span>Community Expert since May 2025; ICT Instructor since September 2026</span></li><li><strong>HSC Batch 24 &amp; 25</strong><span>Founder</span></li><li><strong>Facebook Community Learning Labs – Global</strong><span>Labmin</span></li><li><strong>10 Minute School</strong><span>Affiliate Marketer</span></li><li><strong>hello.bdnews24.com</strong><span>2022–2023</span></li></ul></div><div><p class="eyebrow">02 / Education & recognition</p><h2>Learning <em>continues.</em></h2><ul><li><strong>RUET</strong><span>Urban &amp; Regional Planning, Series 24</span></li><li><strong>Rising Youth Award, 2023</strong><span>Nominee, Best Social Media Community Leader</span></li><li><strong>Mercantile Bank Scholarship</strong><span>Class 8</span></li><li><strong>GPA 5.00</strong><span>PEC, JSC, SSC and HSC</span></li></ul></div></section>
  <section class="shell contact-note" id="contact"><p class="eyebrow">03 / Contact</p><h2>Let’s <em>talk.</em></h2><p>For collaboration, teaching, or planning conversations, reach me through my confirmed public profiles.</p><div><a class="button" href="https://www.linkedin.com/in/fahad-md-akramul-islam/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a class="button ghost" href="https://www.facebook.com/fahad.akramul.islam/" target="_blank" rel="noopener noreferrer">Facebook ↗</a></div></section>
</Base>
<style>
.about-image{display:grid;grid-template-columns:1fr 1fr;gap:7vw;align-items:center;border-top:1px solid var(--line);padding-top:35px}.about-image img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:44%}.about-image h2{font-size:clamp(4rem,6.7vw,8rem);margin:28px 0}.about-image p:last-child{color:var(--muted);max-width:45ch}.about-columns{display:grid;grid-template-columns:1fr 1fr;gap:6vw;padding-top:125px}.about-columns h2{font-size:clamp(3.5rem,5vw,6rem);margin:17px 0 40px}.about-columns ul{padding:0;margin:0;list-style:none;border-top:1px solid var(--line)}.about-columns li{display:grid;grid-template-columns:.55fr .45fr;gap:15px;border-bottom:1px solid var(--line);padding:17px 0;font-size:.9rem}.about-columns li strong{font-weight:600}.about-columns li span{color:var(--muted)}.contact-note{border-top:1px solid var(--ink);margin-top:130px;padding-top:25px}.contact-note h2{font-size:clamp(5rem,9vw,10rem);margin:22px 0}.contact-note p:not(.eyebrow){color:var(--muted);max-width:48ch}.contact-note>div{display:flex;gap:12px;margin-top:28px}
@media(max-width:760px){.about-image,.about-columns{grid-template-columns:1fr}.about-image{gap:40px}.about-image img{aspect-ratio:1.2}.about-image h2{margin:15px 0}.about-columns{gap:70px;padding-top:80px}.contact-note{margin-top:90px}.about-columns li{grid-template-columns:1fr;gap:4px}.contact-note>div{flex-wrap:wrap}}
</style>
