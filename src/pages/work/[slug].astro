---
import Base from '../../layouts/Base.astro';
import MapExplorer from '../../components/MapExplorer.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const b = import.meta.env.BASE_URL;
const media = (name: string) => `${b}media/${name}.webp`;
const current = projects.findIndex(p => p.slug === project.slug);
const next = projects[(current + 1) % projects.length];
const showGallery = !!project.gallery?.length || project.slug === 'when-farmland-stays-underwater';
---
<Base title={`${project.title} — Fahad MD Akramul Islam`} description={project.short}>
  <article>
    <header class:list={['case-intro shell', { 'film-intro': project.slug === 'flyover-paradox' }]}><a class="back-link" href={`${b}work/`}>← All work</a>{project.slug === 'flyover-paradox' && <a class="film-cover" href="#watch-film"><img src={media('flyover-poster')} width="960" height="540" alt="Title frame from The Flyover Paradox documentary" fetchpriority="high" /><span>Watch the complete film ↓</span></a>}<p class="eyebrow">{project.label} / {String(current+1).padStart(2,'0')}</p><h1>{project.title}</h1><div class="case-lede"><p>{project.short}</p><span>Fahad MD Akramul Islam<br />2026 portfolio</span></div></header>
    {project.hero && project.slug !== 'flyover-paradox' ? <div class:list={['case-hero', { 'case-map': project.hero === 'map-board', 'case-teaching': project.hero === 'class-0', 'case-campaign': project.hero === 'campaign-ipad', 'case-nagar': project.hero === 'nagar-0' }]}><img src={media(project.hero)} width={project.hero === 'map-board' ? 2048 : project.hero === 'campaign-ipad' ? 1080 : project.hero === 'nagar-0' || project.hero === 'class-0' ? 720 : 1450} height={project.hero === 'map-board' ? 1447 : project.hero === 'campaign-ipad' ? 1920 : project.hero === 'nagar-0' || project.hero === 'class-0' ? 1600 : 1161} alt={project.heroAlt} fetchpriority="high" /><p>{project.hero === 'campaign-ipad' ? 'Public iPad Giveaway announcement still' : project.hero === 'nagar-0' ? 'NagarBondhu mobile prototype' : project.hero === 'class-0' ? 'Chorcha ICT class interface' : project.hero === 'map-board' ? 'Full source map board — use the viewer below to zoom' : 'The finished waterside model'}</p></div> : project.slug !== 'flyover-paradox' && <div class:list={['case-abstract', project.category]}><div class="shell"><span>{project.label}</span><strong>{project.title}</strong><small>Project notes / Fahad MD Akramul Islam</small></div></div>}
    <div class="shell case-content"><aside><p class="eyebrow">The work</p><h2>At a <em>glance.</em></h2><p class="role-label">My role</p><p>{project.role}</p></aside><div class="case-body"><section><h2>Overview</h2><p>{project.overview}</p></section><section><h2>Evidence &amp; context</h2><ul>{project.evidence.map((item:string) => <li>{item}</li>)}</ul></section>{project.credits && <section><h2>Credits</h2><p>{project.credits}</p></section>}</div></div>
    {project.slug === 'flyover-paradox' && <section class="shell special-section" id="watch-film"><div class="section-heading"><div><p class="eyebrow">Complete documentary</p><h2>Watch the <em>film.</em></h2></div><p class="aside">A web-ready 1080p version of the supplied full 4K file.</p></div><div class="film-player"><video controls playsinline preload="metadata" poster={media('flyover-poster')}><source src={`${b}media/flyover-documentary.mp4`} type="video/mp4" />Your browser cannot play this video.</video><p><a href={`${b}media/flyover-documentary.mp4`} target="_blank">Open the video file ↗</a> · <a href="https://www.facebook.com/reel/2140246113432300" target="_blank" rel="noopener noreferrer">Facebook link ↗</a></p></div></section>}
    {project.slug === 'chorcha-community-campaigns' && <section class="shell special-section"><div class="section-heading"><div><p class="eyebrow">Public examples</p><h2>Campaign <em>moments.</em></h2></div><p class="aside">Public video stills. Facebook may require login; every video has a direct link.</p></div><div class="campaign-grid"><div class="campaign-card"><img src={media('campaign-ipad')} width="1080" height="1920" alt="Still from Fahad's public iPad Giveaway announcement" loading="lazy" /><span>01 / Giveaway</span><strong>আইপ্যাড গিভঅ্যাওয়ে</strong><p>A live announcement and community participation.</p><button class="play-video" data-video="https://www.facebook.com/reel/1114666427997780" type="button">Play video ↗</button><a href="https://www.facebook.com/reel/1114666427997780" target="_blank" rel="noopener noreferrer">Open directly on Facebook ↗</a></div><div class="campaign-card"><img src={media('campaign-1111')} width="1080" height="1920" alt="Still from Fahad's public 11.11 campaign video" loading="lazy" /><span>02 / 11.11</span><strong>১১.১১ ক্যাম্পেইন</strong><p>Campaign communication and learner participation.</p><button class="play-video" data-video="https://www.facebook.com/share/v/1ALMSjKxJH/" type="button">Play video ↗</button><a href="https://www.facebook.com/share/v/1ALMSjKxJH/" target="_blank" rel="noopener noreferrer">Open directly on Facebook ↗</a></div></div></section>}
    {project.slug === 'nagarbondhu-ai' && <section class="shell special-section"><div class="section-heading"><div><p class="eyebrow">Project film & prototype flow</p><h2>See NagarBondhu<br /><em>in action.</em></h2></div><p class="aside">The supplied 90-second explanation video, followed by the app screens below.</p></div><div class="nagar-video"><video controls playsinline preload="none" poster={media('nagarbondhu-video-poster')}><source src={`${b}media/nagarbondhu-story.mp4`} type="video/mp4" />Your browser cannot play this video.</video><p><a href={`${b}media/nagarbondhu-story.mp4`} target="_blank">Open the video file ↗</a> · <a href="https://nagarbondhu-api.onrender.com/" target="_blank" rel="noopener noreferrer">Explore the live prototype ↗</a></p></div><ol class="flow"><li><span>01</span><h3>Report</h3><p>Describe a neighborhood issue in Bengali with text, voice or a photo.</p></li><li><span>02</span><h3>Map</h3><p>See report locations and browse civic information.</p></li><li><span>03</span><h3>Track</h3><p>Follow status, ward views and planning ideas in the prototype.</p></li></ol></section>}
    {project.slug === 'when-farmland-stays-underwater' && <MapExplorer />}
    {showGallery && <section class="shell special-section"><div class="section-heading"><div><p class="eyebrow">Visual record</p><h2>{project.slug === 'when-farmland-stays-underwater' ? 'Read the map.' : 'The process.'}</h2></div><p class="aside">Select an image to enlarge. In the viewer, use Zoom for full resolution.</p></div><div class:list={['gallery', { 'map-gallery': project.slug === 'when-farmland-stays-underwater', 'nagar-gallery': project.slug === 'nagarbondhu-ai' }]}>{project.slug === 'when-farmland-stays-underwater' ? <figure><button class="gallery-trigger" type="button" data-src={media('map-board')} data-alt="Full source map board with methods, findings and source credits"><img src={media('map-board')} width="2048" height="1447" alt="Full GIS map board with Bangladesh, Naogaon and Manda detail" loading="lazy" /><span>Enlarge map ↗</span></button><figcaption>Original map board, including methodology and source credits.</figcaption></figure> : project.gallery?.map((item:{src:string;alt:string;caption:string}) => <figure><button class="gallery-trigger" type="button" data-src={media(item.src)} data-alt={item.alt}><img src={media(item.src)} alt={item.alt} loading="lazy" /><span>Enlarge ↗</span></button><figcaption>{item.caption}</figcaption></figure>)}</div></section>}
    {project.links?.length && <section class="shell special-section"><div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2>Public <em>links.</em></h2></div></div><ul class="public-links">{project.links.map((link:{label:string;url:string}) => <li><a href={link.url} target="_blank" rel="noopener noreferrer"><span>{link.label}</span><span aria-hidden="true">↗</span></a></li>)}</ul></section>}
    <nav class="shell next-work" aria-label="Next project"><span>Next project</span><a href={`${b}work/${next.slug}/`}>{next.title} <span aria-hidden="true">↗</span></a></nav>
  </article>
  <dialog id="image-viewer" aria-label="Enlarged project image"><div class="viewer-controls"><button type="button" id="zoom-toggle" aria-pressed="false">Zoom in</button><button type="button" id="viewer-close">Close ×</button></div><div class="viewer-scroll"><img alt="" /></div></dialog>
  <script>
    const viewer = document.querySelector<HTMLDialogElement>('#image-viewer');
    const viewerImage = viewer?.querySelector<HTMLImageElement>('img');
    const close = document.querySelector<HTMLButtonElement>('#viewer-close');
    const zoom = document.querySelector<HTMLButtonElement>('#zoom-toggle');
    let opener: HTMLButtonElement | null = null;
    document.querySelectorAll<HTMLButtonElement>('.gallery-trigger').forEach(trigger => trigger.addEventListener('click', () => {
      if (!viewer || !viewerImage) return;
      opener = trigger;
      viewerImage.src = trigger.dataset.src || '';
      viewerImage.alt = trigger.dataset.alt || '';
      viewer.classList.remove('zoomed');
      zoom?.setAttribute('aria-pressed','false');
      if (zoom) zoom.textContent = 'Zoom in';
      viewer.showModal();
      close?.focus();
    }));
    close?.addEventListener('click', () => viewer?.close());
    viewer?.addEventListener('click', event => { if (event.target === viewer) viewer.close(); });
    viewer?.addEventListener('close', () => { if (viewerImage) viewerImage.src = ''; opener?.focus(); });
    zoom?.addEventListener('click', () => {
      const active = viewer?.classList.toggle('zoomed') || false;
      zoom.setAttribute('aria-pressed', String(active));
      zoom.textContent = active ? 'Fit image' : 'Zoom in';
    });
    document.querySelectorAll<HTMLButtonElement>('.play-video').forEach(button => button.addEventListener('click', () => {
      const url = button.dataset.video;
      if (!url) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false`;
      frame.title = 'Facebook campaign video';
      frame.loading = 'lazy';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      button.replaceWith(frame);
    }));
  </script>
</Base>
<style>
.case-intro{padding-top:45px;padding-bottom:55px}.back-link{display:inline-block;font-size:.78rem;font-weight:600;text-decoration:none;margin-bottom:70px}.case-intro h1{font-size:clamp(5rem,9vw,10rem);letter-spacing:-.045em;max-width:12ch;margin-top:18px}.case-lede{display:flex;justify-content:space-between;gap:30px;align-items:end;border-top:1px solid var(--line);margin-top:45px;padding-top:15px}.case-lede p{font-size:1.18rem;max-width:48ch}.case-lede span{font-size:.72rem;color:var(--muted);text-align:right}.case-hero{width:min(1500px,calc(100% - 72px));margin:auto;background:var(--mist)}.case-hero img{display:block;width:100%;max-height:680px;object-fit:cover}.case-hero p{padding:10px 0;color:var(--muted);font-size:.73rem;background:var(--paper)}.case-map img{object-fit:contain;background:white;max-height:800px}.case-teaching img{object-fit:contain;background:#dce5e7;padding:40px}.case-abstract{background:#dce8df;color:var(--ink)}.case-abstract.studio{background:#e7e1d7}.case-abstract .shell{height:500px;padding-block:36px;display:flex;flex-direction:column;justify-content:space-between}.case-abstract span,.case-abstract small{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em}.case-abstract strong{font:clamp(4rem,8vw,8rem)/.9 var(--serif);max-width:11ch}.case-content{display:grid;grid-template-columns:.4fr .6fr;gap:80px;padding-top:110px;padding-bottom:50px}.case-content aside h2{font-size:5rem;margin:18px 0 55px}.case-content aside .role-label{color:var(--muted);font-size:.73rem;text-transform:uppercase;letter-spacing:.08em}.case-content aside p:last-child{margin-top:8px;max-width:30ch}.case-body section+section{border-top:1px solid var(--line);padding-top:28px;margin-top:35px}.case-body h2{font:2.4rem var(--serif);margin-bottom:16px}.case-body p,.case-body li{color:var(--muted);max-width:66ch}.case-body li+li{margin-top:14px}.case-body ul{padding-left:20px;margin:0}.special-section{padding-top:95px}.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:28px}.gallery figure{min-width:0}.gallery-trigger{width:100%;border:0;padding:0;background:var(--mist);text-align:left;cursor:zoom-in;position:relative}.gallery-trigger img{width:100%;height:330px;object-fit:cover}.gallery-trigger span{position:absolute;right:12px;bottom:12px;background:var(--paper);padding:8px 12px;color:var(--ink);font-size:.75rem;font-weight:600}.gallery figcaption{font-size:.76rem;color:var(--muted);margin-top:8px}.map-gallery{grid-template-columns:1fr}.map-gallery img{height:auto;max-height:780px;object-fit:contain;background:white}.public-links{padding:0;margin:0;list-style:none;border-top:1px solid var(--line)}.public-links a{min-height:58px;padding:15px 0;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px;font-weight:600;text-decoration:none}.public-links a:hover{color:var(--accent)}.next-work{border-top:1px solid var(--ink);margin-top:120px;padding-top:20px}.next-work>span{display:block;color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.1em}.next-work a{display:flex;justify-content:space-between;gap:20px;text-decoration:none;font:clamp(3rem,6vw,6rem)/1 var(--serif);margin-top:15px;color:var(--ink)}.next-work a:hover{color:var(--accent)}.campaign-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.campaign-card{background:#dce8df;padding:30px;min-height:350px;display:flex;flex-direction:column;align-items:start}.campaign-card:nth-child(2){background:#e8e1d5}.campaign-card span{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em}.campaign-card strong{font:clamp(2.7rem,4vw,5rem)/1.1 var(--serif);margin:auto 0 20px}.campaign-card p{color:var(--muted);margin-bottom:20px}.campaign-card button{border:1px solid var(--ink);background:var(--ink);color:white;padding:9px 15px;min-height:44px;cursor:pointer}.campaign-card a{font-size:.75rem;margin-top:14px}.campaign-card iframe{width:100%;height:300px;border:0;margin-top:auto}.flow{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.flow li{border-top:1px solid var(--ink);padding-top:14px}.flow li span{font-size:.75rem;color:var(--muted)}.flow h3{font-size:4rem;margin:40px 0 15px}.flow p{color:var(--muted)}#image-viewer{width:min(98vw,1600px);max-width:none;height:min(96vh,1050px);max-height:none;padding:0;border:0;background:#f3f0e8;color:var(--ink)}#image-viewer::backdrop{background:#0d211fe8}.viewer-controls{height:56px;display:flex;justify-content:flex-end;gap:8px;padding:7px;border-bottom:1px solid var(--line)}.viewer-controls button{border:1px solid var(--ink);background:var(--paper);padding:7px 12px;min-width:80px;cursor:pointer}.viewer-scroll{height:calc(100% - 56px);overflow:auto;display:flex;align-items:flex-start;justify-content:center;touch-action:pan-x pan-y pinch-zoom}.viewer-scroll img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;margin:auto}.zoomed .viewer-scroll img{max-width:none;max-height:none;width:auto;height:auto;margin:0}
.case-campaign img{height:620px;object-fit:contain;background:#d9ddd7}.case-nagar img{object-fit:cover;object-position:center top}.campaign-card img{width:100%;height:280px;object-fit:cover;object-position:center 43%;margin-bottom:20px}.campaign-card:nth-child(2) img{object-position:center 55%}.campaign-card strong{margin:16px 0!important}.campaign-card p{margin-top:0}.campaign-card iframe{min-height:300px}.nagar-gallery{grid-template-columns:1fr}.nagar-gallery .gallery-trigger img{width:100%;height:auto;max-height:660px;object-fit:contain;background:white}
@media(max-width:760px){.case-intro{padding-top:30px;padding-bottom:35px}.back-link{margin-bottom:50px}.case-intro h1{font-size:clamp(4.2rem,12vw,7rem)}.case-lede{align-items:start}.case-lede span{display:none}.case-hero{width:calc(100% - 36px)}.case-hero img{max-height:450px}.case-abstract .shell{height:370px}.case-content{grid-template-columns:1fr;gap:35px;padding-top:65px}.case-content aside h2{margin-bottom:25px}.special-section{padding-top:65px}.gallery{gap:14px}.gallery-trigger img{height:220px}.campaign-grid,.flow{grid-template-columns:1fr}.flow h3{margin-top:15px}.next-work{margin-top:80px}}
@media(max-width:500px){.case-intro h1{font-size:4.3rem}.gallery{grid-template-columns:1fr}.gallery-trigger img{height:280px}.case-body h2{font-size:2.1rem}.case-content aside h2{font-size:4.2rem}.next-work a{font-size:3.2rem}.case-teaching img{padding:15px}}
.case-nagar img{object-fit:contain;background:#e5ecf0}.gallery-trigger img{object-fit:contain;background:#e9eeeb}.campaign-card img{object-fit:contain;background:#d1e0de}.campaign-card:nth-child(2) img{background:#e1d8ca}
.case-nagar,.case-teaching{background:#132b37}.case-nagar img,.case-teaching img{width:auto;max-width:100%;height:620px;margin:auto;padding:12px;object-fit:contain;background:transparent}.nagar-gallery{grid-template-columns:repeat(3,minmax(0,1fr))}.nagar-gallery .gallery-trigger img{height:520px;max-height:none;object-fit:contain;background:#e8edf0}.nagar-video{background:#0b2330;padding:25px;text-align:center;margin-bottom:50px}.nagar-video video{display:block;height:min(70vh,660px);width:100%;object-fit:contain;background:#061b24}.nagar-video p{color:white;margin-top:15px}.nagar-video a{color:#20d7e8}
@media(max-width:760px){.nagar-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.nagar-gallery .gallery-trigger img{height:380px}.case-nagar img,.case-teaching img{height:450px}.nagar-video{padding:10px}}
@media(max-width:500px){.nagar-gallery{grid-template-columns:1fr}.nagar-gallery .gallery-trigger img{height:auto;max-height:580px}}
.case-intro h1{font:800 clamp(3.5rem,6.5vw,6.7rem)/1.08 var(--sans);letter-spacing:-.055em;max-width:16ch}.case-content aside h2{font:800 clamp(2.4rem,4vw,4rem)/1.08 var(--sans)}.case-body h2{font:700 1.6rem var(--sans)}.campaign-card strong,.next-work a,.flow h3{font-family:var(--sans);font-weight:800}
@media(max-width:500px){.case-intro h1{font-size:clamp(2.55rem,10vw,3.8rem)}.case-content aside h2{font-size:2.6rem}}
.film-intro .back-link{margin-bottom:24px}.film-cover{display:block;position:relative;width:min(100%,900px);margin:0 auto 35px;text-decoration:none;background:#061824}.film-cover img{display:block;width:100%;height:auto}.film-cover span{position:absolute;right:14px;bottom:14px;background:#20d7e8;color:#071d2a;padding:10px 15px;border-radius:999px;font-size:.76rem;font-weight:800}.film-intro h1{font-size:clamp(2.3rem,3.5vw,3.6rem);max-width:26ch;margin-top:12px}.film-intro .case-lede{margin-top:25px}.film-player{background:#081d29;padding:24px;color:white}.film-player video{display:block;width:100%;max-height:75vh;background:#000}.film-player p{padding-top:12px}.film-player a{color:#20d7e8}.film-player a:hover{text-decoration:none}#watch-film{scroll-margin-top:90px}
@media(max-width:500px){.film-intro h1{font-size:2rem}.film-cover span{font-size:.68rem}.film-player{padding:10px}}
</style>
