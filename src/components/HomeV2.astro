---
import { projects } from '../data/projects';
import '../styles/home-v2.css';
const b = import.meta.env.BASE_URL;
const media = (name: string) => `${b}media/${name}.webp`;
const route = (slug: string) => `${b}work/${slug}/`;
const [community, teaching, nagar, map] = projects;
const fields = [
  { icon: '◎', title: 'Community & campaigns', text: 'Helping learners, shaping clear messages and coordinating participation at Chorcha.', link: route(community.slug) },
  { icon: '▣', title: 'ICT teaching', text: 'Teaching SSC 27 and HSC ICT with lessons students can follow inside the Chorcha app.', link: route(teaching.slug) },
  { icon: '</>', title: 'HTML & web interfaces', text: 'Building and presenting working interfaces, including the NagarBondhu civic prototype.', link: route(nagar.slug) },
  { icon: '▥', title: 'SPSS & Stata', text: 'Using statistical tools in my planning and research coursework; continuing to develop these skills.', link: route(projects[4].slug) },
  { icon: '⌖', title: 'Urban planning', text: 'Studying places and public services at RUET through surveys, mapping and design.', link: route(projects[4].slug) },
  { icon: '◈', title: 'GIS in progress', text: 'Learning GIS through hands-on map projects. My Naogaon flood map is one documented example.', link: route(map.slug) },
];
---
<section class="hero" id="home">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">Community · Planning · GIS</p>
      <h1>Fahad <span class="name-md">MD</span><br /><span>Akramul</span><span class="name-last">Islam.</span></h1>
      <p class="dynamic-role">I’m a <strong data-role-text>Community Expert</strong><span class="cursor" aria-hidden="true"></span></p>
      <p class="hero-intro">I work with learners and use urban planning, GIS and civic technology to explore better places and public services.</p>
      <div class="socials" aria-label="Social profiles"><a href="https://www.linkedin.com/in/fahad-md-akramul-islam/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a><a href="https://github.com/fahadakramul" target="_blank" rel="noopener noreferrer" aria-label="GitHub">GH</a><a href="https://www.facebook.com/fahad.akramul.islam/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">f</a><a href="https://x.com/akramul1_fahad" target="_blank" rel="noopener noreferrer" aria-label="X">𝕏</a><a href="https://www.instagram.com/fahad_akramul/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">◎</a></div>
      <div class="hero-actions"><a class="pill" href="#featured">Explore projects <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#resume">My background ↓</a></div>
    </div>
    <div class="hero-art"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="portrait"><img src={`${b}media/fahad-portrait.png`} width="1102" height="1427" alt="Fahad MD Akramul Islam wearing a blue suit" fetchpriority="high" /></div><span class="art-label">FAHAD / 2026</span></div>
  </div>
</section>

<section class="numbers" aria-label="Work in numbers"><div class="shell number-grid"><div><strong>35K → 160K</strong><span>Chorcha community members during my tenure<br />May 2025 – Nov 2026</span></div><div><strong>25+</strong><span>Professional projects contributed to</span></div><div><strong>8</strong><span>Selected projects to explore below</span></div></div></section>

<section class="proficiency section" id="proficiency"><div class="shell"><div class="section-heading" data-reveal><p class="eyebrow">What I do</p><h2>Skills in <span>practice.</span></h2><p>A mix of established work and tools I am actively learning.</p></div><div class="field-grid">{fields.map(field => <a class="field-card" href={field.link} data-reveal><span class="field-icon" aria-hidden="true">{field.icon}</span><h3>{field.title}</h3><p>{field.text}</p><span class="card-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>

<section class="projects section" id="featured"><div class="shell"><div class="section-heading" data-reveal><p class="eyebrow">Selected projects</p><h2>See the <span>work.</span></h2><p>Explore Chorcha, civic technology and my planning work. Research, posters and film are linked below.</p></div>
  <div class="project-switcher" data-project-switcher><div class="project-tabs" role="tablist" aria-label="Featured projects"><button id="tab-community" role="tab" aria-controls="panel-community" aria-selected="true" tabindex="0" type="button">01 <strong>Community</strong></button><button id="tab-teaching" role="tab" aria-controls="panel-teaching" aria-selected="false" tabindex="-1" type="button">02 <strong>Teaching</strong></button><button id="tab-planning" role="tab" aria-controls="panel-planning" aria-selected="false" tabindex="-1" type="button">03 <strong>NagarBondhu</strong></button></div>
    <div class="project-mobile-controls"><button type="button" data-project-prev aria-label="Previous project">←</button><span data-project-count>01 / 03</span><button type="button" data-project-next aria-label="Next project">→</button></div>
    <div class="project-panels"><article id="panel-community" role="tabpanel" aria-labelledby="tab-community" class="project-panel"><div class="project-visual campaign-visual"><span class="campaign-symbol">iPad</span><span>Chorcha giveaway / 2026</span></div><div class="project-description"><p class="eyebrow">Community & campaigns</p><h3>A community<br />in motion.</h3><p>I support learners, write campaign messages and help coordinate participation. The public iPad Giveaway announcement shows one campaign moment.</p><a class="pill" href={route(community.slug)}>Explore some of my projects in Chorcha ↗</a><a class="under-link" href="https://www.facebook.com/reel/1114666427997780" target="_blank" rel="noopener noreferrer">Watch iPad Giveaway ↗</a></div></article>
    <article id="panel-teaching" role="tabpanel" aria-labelledby="tab-teaching" class="project-panel"><div class="project-visual phones"><div class="phone"><img src={media('class-0')} width="720" height="1600" alt="Chorcha ICT class interface with Fahad's lessons" loading="lazy" /></div><div class="phone second"><img src={media('class-2')} width="720" height="1600" alt="Chorcha ICT lesson screen" loading="lazy" /></div></div><div class="project-description"><p class="eyebrow">ICT teaching</p><h3>Inside my<br />classroom.</h3><p>My SSC 27 and HSC ICT lessons are visible in the Chorcha app. These screens show class listings, not paid lesson content.</p><a class="pill" href={route(teaching.slug)}>Explore project ↗</a></div></article>
    <article id="panel-planning" role="tabpanel" aria-labelledby="tab-planning" class="project-panel"><div class="project-visual phones"><div class="phone"><img src={media('nagar-0')} width="720" height="1600" alt="NagarBondhu mobile home screen" loading="lazy" /></div><div class="phone second"><img src={media('nagar-3')} width="720" height="1600" alt="NagarBondhu issue map screen" loading="lazy" /></div></div><div class="project-description"><p class="eyebrow">Civic prototype</p><h3>NagarBondhu<br />AI.</h3><p>With Tashika Hossain, I made a Bengali prototype for reporting neighborhood issues, seeing them on a map and tracking their status.</p><a class="pill" href={route(nagar.slug)}>Explore project ↗</a><a class="under-link" href="https://nagarbondhu-api.onrender.com/" target="_blank" rel="noopener noreferrer">Open live prototype ↗</a></div></article></div></div>
  <div class="more-work"><p>More to explore</p><div class="more-work-links"><a href={route(projects[4].slug)}>Research survey ↗</a><a href={route(projects[6].slug)}>Poster ↗</a><a href={route(projects[5].slug)}>Documentary ↗</a><a href={`${b}work/`}>All eight projects ↗</a></div></div></div></section>

<section class="nagar-focus section"><div class="shell focus-grid"><div class="focus-copy" data-reveal><p class="eyebrow">Project spotlight</p><h2>See the <span>actual app.</span></h2><p>NagarBondhu moves from reporting an issue to exploring the map and following its status. The uploaded explanation video tells the project story in full.</p><div class="focus-links"><a class="pill" href={route(nagar.slug)}>Explore NagarBondhu ↗</a><a class="under-link" href={`${b}media/nagarbondhu-story.mp4`} target="_blank">Watch explanation video ↗</a></div><ul><li>Report with Bangla text, voice and photo</li><li>Map issues and browse local information</li><li>Track reports and explore ward views</li><li>Independent prototype with Tashika Hossain</li></ul></div><div class="focus-media" data-reveal><div class="focus-screens"><div class="phone"><img src={media('nagar-5')} width="720" height="1600" alt="NagarBondhu issue report screen" loading="lazy" /></div><div class="phone"><img src={media('nagar-3')} width="720" height="1600" alt="NagarBondhu map screen" loading="lazy" /></div><div class="phone"><img src={media('nagar-4')} width="720" height="1600" alt="NagarBondhu tracking screen" loading="lazy" /></div></div><div class="video-card"><img src={media('nagarbondhu-video-poster')} width="540" height="960" alt="NagarBondhu explanation video preview" loading="lazy" /><button type="button" data-open-video aria-label="Play NagarBondhu explanation video">▶ <span>Play project film</span></button></div></div></div></section>

<section class="resume section" id="resume"><div class="shell resume-grid"><div data-reveal><p class="eyebrow">My resume</p><h2>Where I’m<br /><span>going.</span></h2><p>Urban & Regional Planning student at Rajshahi University of Engineering & Technology (RUET), Chorcha community professional and ICT instructor. I use projects to connect people, technology and places.</p><div class="resume-tabs" role="tablist" aria-label="Resume sections"><button type="button" id="resume-tab-experience" role="tab" aria-controls="resume-experience" aria-selected="true" tabindex="0">Experience</button><button type="button" id="resume-tab-education" role="tab" aria-controls="resume-education" aria-selected="false" tabindex="-1">Education</button><button type="button" id="resume-tab-skills" role="tab" aria-controls="resume-skills" aria-selected="false" tabindex="-1">Skills & tools</button></div></div><div class="resume-panels" data-reveal><div id="resume-experience" role="tabpanel" aria-labelledby="resume-tab-experience"><h3>Experience</h3><div class="resume-cards"><div><small>May 2025 – present</small><h4>Community Expert</h4><p>Chorcha · learner support, feedback and campaign communication.</p></div><div><small>September 2026 – present</small><h4>ICT Instructor</h4><p>Chorcha · SSC 27 and HSC ICT classes.</p></div><div><small>Earlier experience</small><h4>Community & publishing</h4><p>Founder, HSC Batch 24 & 25; Facebook Community Learning Labs – Global; 10 Minute School affiliate; hello.bdnews24.com (2022–2023).</p></div></div></div><div id="resume-education" role="tabpanel" aria-labelledby="resume-tab-education"><h3>Education & recognition</h3><div class="resume-cards"><div><small>Series 24 · current</small><h4>Rajshahi University of Engineering & Technology</h4><p>Urban & Regional Planning (RUET).</p></div><div><small>2024 · GPA 5.00</small><h4>Rajshahi Govt Model School & College</h4><p>HSC, Rajshahi.</p></div><div><small>Briefly attended</small><h4>Varendra College, Rajshahi</h4><p>Studied here for a short period before moving to Rajshahi Govt Model School & College.</p></div><div><small>2023</small><h4>Rising Youth Award</h4><p>Nominee, Best Social Media Community Leader.</p></div><div><small>2019 · 2022 · GPA 5.00</small><h4>Baidyapur High School</h4><p>JSC (2019) and SSC (2022), Manda, Naogaon.</p></div><div><small>PEC · GPA 5.00</small><h4>Baidyapur Govt. Primary School</h4><p>Primary education and PEC.</p></div><div><small>Play group – Class 4</small><h4>Del Afroj Kinder Garten</h4><p>Early school years in Manda, Naogaon.</p></div><div><small>Recognition</small><h4>Mercantile Bank Scholarship</h4><p>Class 8.</p></div></div></div><div id="resume-skills" role="tabpanel" aria-labelledby="resume-tab-skills"><h3>Skills & tools</h3><div class="resume-cards"><div><small>Practice</small><h4>Communication & teaching</h4><p>Student support, campaign writing, instructional delivery and digital publishing.</p></div><div><small>Working experience</small><h4>HTML · SPSS · Stata</h4><p>Web interfaces and statistical tools used in projects and coursework.</p></div><div><small>Learning</small><h4>GIS & spatial analysis</h4><p>Developing GIS skills through maps, field questions and planning study.</p></div></div></div></div></div></section>

<section class="contact-strip" id="contact"><div class="shell"><p class="eyebrow">Contact</p><h2>Let’s make<br /><span>something useful.</span></h2><p>For a personal message or a conversation about community work, urban planning or GIS, email me directly.</p><div class="contact-links"><a href="mailto:fahadakramul46@gmail.com">Email me ↗</a><a href="https://github.com/fahadakramul" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/fahad-md-akramul-islam/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://x.com/akramul1_fahad" target="_blank" rel="noopener noreferrer">X ↗</a><a href="https://www.instagram.com/fahad_akramul/" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="https://www.facebook.com/fahad.akramul.islam/" target="_blank" rel="noopener noreferrer">Facebook ↗</a></div></div></section>

<dialog class="video-dialog" aria-label="NagarBondhu explanation video"><div><strong>NagarBondhu AI / project story</strong><button type="button" data-close-video aria-label="Close video">Close ×</button></div><video controls playsinline preload="none" poster={media('nagarbondhu-video-poster')}><source src={`${b}media/nagarbondhu-story.mp4`} type="video/mp4" />Your browser cannot play this video.</video><p><a href={`${b}media/nagarbondhu-story.mp4`} target="_blank">Open video file ↗</a></p></dialog>
<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const role = document.querySelector<HTMLElement>('[data-role-text]');
  const words = ['Community Expert', 'ICT Instructor', 'Urban Planning Student'];
  let word = 0, timer = 0;
  function cycle() { if (!role || motion.matches || document.hidden) return; word = (word + 1) % words.length; role.classList.remove('role-enter'); void role.offsetWidth; role.textContent = words[word]; role.classList.add('role-enter'); timer = window.setTimeout(cycle, 2800); }
  function syncRole() { clearTimeout(timer); if (role) role.textContent = words[word]; if (!motion.matches && !document.hidden) timer = window.setTimeout(cycle, 2800); }
  syncRole(); motion.addEventListener('change', syncRole); document.addEventListener('visibilitychange', syncRole);
  function tabs(rootSelector: string) { const root = document.querySelector<HTMLElement>(rootSelector); if (!root) return; const buttons = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')]; const panels = buttons.map(button => document.getElementById(button.getAttribute('aria-controls') || ''));
    function activate(index: number, focus = false) { buttons.forEach((button,i) => { button.setAttribute('aria-selected',String(i===index)); button.tabIndex=i===index?0:-1; }); panels.forEach((panel,i) => { if (panel) panel.hidden=i!==index; }); if (focus) buttons[index].focus(); }
    buttons.forEach((button,i) => { button.addEventListener('click',()=>activate(i)); button.addEventListener('keydown',event=>{ let next=i; if(event.key==='ArrowRight'||event.key==='ArrowDown') next=(i+1)%buttons.length; else if(event.key==='ArrowLeft'||event.key==='ArrowUp') next=(i-1+buttons.length)%buttons.length; else if(event.key==='Home') next=0; else if(event.key==='End') next=buttons.length-1; else return; event.preventDefault(); activate(next,true); }); }); activate(0);
  }
  tabs('[data-project-switcher]'); tabs('.resume-grid');
  const projectTabs = [...document.querySelectorAll<HTMLButtonElement>('.project-tabs [role="tab"]')];
  const projectCount = document.querySelector<HTMLElement>('[data-project-count]');
  const currentProject = () => Math.max(0, projectTabs.findIndex(tab => tab.getAttribute('aria-selected') === 'true'));
  const syncProjectCount = () => { if (projectCount) projectCount.textContent = `${String(currentProject()+1).padStart(2,'0')} / ${String(projectTabs.length).padStart(2,'0')}`; };
  const projectObserver = new MutationObserver(syncProjectCount);
  projectTabs.forEach(tab => projectObserver.observe(tab, { attributes: true, attributeFilter: ['aria-selected'] }));
  document.querySelector('[data-project-prev]')?.addEventListener('click', () => projectTabs[(currentProject()-1+projectTabs.length)%projectTabs.length]?.click());
  document.querySelector('[data-project-next]')?.addEventListener('click', () => projectTabs[(currentProject()+1)%projectTabs.length]?.click());
  const projectPanels = document.querySelector<HTMLElement>('.project-panels');
  let touchStartX = 0, touchStartY = 0;
  projectPanels?.addEventListener('touchstart', event => { touchStartX = event.changedTouches[0].screenX; touchStartY = event.changedTouches[0].screenY; }, { passive: true });
  projectPanels?.addEventListener('touchend', event => { const dx = event.changedTouches[0].screenX - touchStartX; const dy = event.changedTouches[0].screenY - touchStartY; if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.4) projectTabs[(currentProject() + (dx < 0 ? 1 : -1) + projectTabs.length)%projectTabs.length]?.click(); }, { passive: true });
  if (!motion.matches && 'IntersectionObserver' in window) { document.documentElement.classList.add('has-reveal'); const observer = new IntersectionObserver(entries=>entries.forEach(entry=>{ if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target);} }),{threshold:.08}); document.querySelectorAll('[data-reveal]').forEach(el=>observer.observe(el)); motion.addEventListener('change',()=>{if(motion.matches){document.documentElement.classList.remove('has-reveal');observer.disconnect();}}); }
  const dialog = document.querySelector<HTMLDialogElement>('.video-dialog'); const video = dialog?.querySelector('video'); const open = document.querySelector<HTMLButtonElement>('[data-open-video]'); open?.addEventListener('click',()=>{dialog?.showModal(); video?.play().catch(()=>{});}); dialog?.querySelector('[data-close-video]')?.addEventListener('click',()=>dialog?.close()); dialog?.addEventListener('close',()=>{video?.pause();open?.focus();}); dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
</script>
